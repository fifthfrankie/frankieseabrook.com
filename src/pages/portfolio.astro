---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<a href="/" class="back">< back</a>
		<h1>portfolio</h1>
		<ul class="links">
			<li><a href="https://github.com/fifthfrankie" target="_blank" rel="noopener">github</a></li>
		</ul>
	</main>
</Layout>

<style>
	:global(body) {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}
	main {
		max-width: 600px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}
	.back {
		color: var(--text);
		text-decoration: none;
		opacity: 0.6;
	}
	.back:hover { opacity: 1; }
	h1 {
		font-size: 2rem;
		font-weight: 600;
		margin: 2rem 0;
	}
	.links {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.links a {
		display: block;
		padding: 1rem 0;
		color: var(--text);
		text-decoration: none;
		border-bottom: 1px solid var(--border);
	}
	.links a:hover { opacity: 0.6; }
</style>
