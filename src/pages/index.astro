---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<h1 class="logo" data-text="frankie seabrook" data-alt="data consultant">frankie seabrook</h1>
		<nav class="nav">
			<a href="/portfolio">portfolio</a>
			<a href="/cv">cv</a>
			<a href="/blog">blog</a>
		</nav>
	</main>
</Layout>

<style>
	:global(body) {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}
	main {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
	}
	.logo {
		font-size: clamp(2rem, 8vw, 5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0;
	}
	.nav {
		display: flex;
		gap: 2rem;
		margin-top: 2rem;
	}
	.nav a {
		color: var(--text);
		text-decoration: none;
		font-size: 1.25rem;
	}
	.nav a:hover {
		opacity: 0.6;
	}
</style>

<script>
	const logo = document.querySelector('.logo') as HTMLElement;
	const mainText = logo?.dataset.text || '';
	const altText = logo?.dataset.alt || '';

	function flicker() {
		if (!logo) return;
		logo.style.opacity = '0.1';
		setTimeout(() => { logo.style.opacity = '1'; }, 80);
		setTimeout(() => { logo.style.opacity = '0.5'; }, 150);
		setTimeout(() => { logo.style.opacity = '1'; }, 200);
		setTimeout(() => { logo.style.opacity = '0.1'; logo.textContent = altText; }, 280);
		setTimeout(() => { logo.style.opacity = '1'; }, 360);
		setTimeout(() => { logo.style.opacity = '0.1'; }, 500);
		setTimeout(() => { logo.style.opacity = '1'; logo.textContent = mainText; }, 580);
	}

	setTimeout(() => { flicker(); setInterval(flicker, 5000); }, 2000);
</script>
