---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
	<main>
		<a href="/blog" class="back">< back</a>
		<article>
			<h1>hello world</h1>
			<time>2026-01-23</time>
			<p>first post. testing the waters.</p>
			<p>this blog will cover data, code, and whatever else i find interesting.</p>
			<p>stay tuned.</p>
		</article>
	</main>
</Layout>

<style>
	:global(body) {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}
	main {
		max-width: 600px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}
	.back {
		color: var(--text);
		text-decoration: none;
		opacity: 0.6;
	}
	.back:hover { opacity: 1; }
	h1 {
		font-size: 2rem;
		font-weight: 600;
		margin: 2rem 0 0.5rem;
	}
	time {
		display: block;
		opacity: 0.5;
		margin-bottom: 2rem;
	}
	p {
		line-height: 1.7;
		opacity: 0.85;
		margin: 0 0 1rem;
	}
</style>
