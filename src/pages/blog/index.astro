---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
	<main>
		<a href="/" class="back">< back</a>
		<h1>blog</h1>
		<ul class="posts">
			<li><a href="/blog/hello-world"><span>hello world</span><span class="date">2026-01-23</span></a></li>
		</ul>
	</main>
</Layout>

<style>
	:global(body) {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}
	main {
		max-width: 600px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}
	.back {
		color: var(--text);
		text-decoration: none;
		opacity: 0.6;
	}
	.back:hover { opacity: 1; }
	h1 {
		font-size: 2rem;
		font-weight: 600;
		margin: 2rem 0;
	}
	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.posts a {
		display: flex;
		justify-content: space-between;
		padding: 1rem 0;
		color: var(--text);
		text-decoration: none;
		border-bottom: 1px solid var(--border);
	}
	.posts a:hover { opacity: 0.6; }
	.date { opacity: 0.5; font-variant-numeric: tabular-nums; }
</style>
